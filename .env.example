# SospechAI · variables de entorno (plantilla sin valores reales)
#
# 1. Copia este archivo a `.env` (que está en .gitignore).
# 2. Pon tu token real de Hugging Face.
# 3. Nunca subas `.env` al repositorio.

HF_TOKEN=

# Modelo/proveedor del experimento; se puede cambiar según el router.
# El valor viaja por gRPC en GenerationConfig.model_id (contrato v1 congelado).
SOSPECHAI_MODEL_ID=Qwen/Qwen2.5-7B-Instruct:featherless-ai